{
  "manifest_version": 3,
  "name": "Quick Clinical Notes",
  "description": "Fast, distraction-free clinical note capture with insert and patient reset.",
  "version": "1.1.0",
  "action": {
    "default_title": "Quick Clinical Notes",
    "default_popup": "popup/popup.html"
  },
  "permissions": [
    "storage",
    "clipboardWrite",
    "activeTab",
    "scripting"
  ],
  "background": {
    "service_worker": "service_worker.js",
    "type": "module"
  },
  "icons": {
    "16": "assets/icons/icon16.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  }
}
